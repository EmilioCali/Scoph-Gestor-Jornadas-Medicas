# Copiar a cada servicio o usar env_file local. No pegar secretos reales.

NODE_ENV=production

# Auth
# MONGODB_URI=  (en Docker con Mongo en el host usa host.docker.internal, no localhost)
# PORT=3020
# MONGODB_URI=
# JWT_SECRET=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# En Render usa Resend (SMTP del plan free está bloqueado).
# FRONTEND_URL=
# CORS_ORIGIN=
# VERIFICATION_TOKEN_EXPIRES_MINUTES=10
# ADMIN_CORREO=
# ADMIN_NOMBRE=
# ADMIN_APELLIDO=
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# CORE_SERVICE_URL=http://core-service:3022
# LOG_LEVEL=info
# NODE_DNS_SERVERS=

# Core / Workday / Report
# PORT=
# MONGO_URI=
# WORKDAY_SERVICE_URL=http://workday-service:3021
# WORKDAY_SERVICE_HOSTPORT=workday-service:3021
# AUTH_SERVICE_URL=http://auth-service:3020
# AUTH_SERVICE_HOSTPORT=auth-service:3020
# CORE_SERVICE_URL=http://core-service:3022
# CORE_SERVICE_HOSTPORT=core-service:3022
# RATE_LIMIT_MAX=500
# WORKDAY_TIMEZONE=America/Guatemala
