# SCOPH — un solo archivo para local, Compose y el contenedor de Render.
# Copiar: cp .env.example .env
# .env no se sube a Git. En Render pega las mismas claves en el servicio `scoph`.

NODE_ENV=production

# --- Mongo (fuera del contenedor) ---
# Auth usa MONGODB_URI. Core, workday y report usan MONGO_URI.
# En Docker hacia Mongo en el host: mongodb://host.docker.internal:27017/<db>
MONGODB_URI=
MONGO_URI=

# --- JWT (el mismo valor para las cuatro APIs) ---
JWT_SECRET=

# --- Correo: en Render solo Resend (SMTP del plan free está bloqueado) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# SMTP solo para desarrollo local, si no usas Resend:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Origen público ---
# Local: Vite. Producción Render: https://scoph.onrender.com (sin slash final)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# --- Primer SUPER_ADMIN (seed de auth) ---
ADMIN_CORREO=
ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=SCOPH
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
VERIFICATION_TOKEN_EXPIRES_MINUTES=10

# --- Opcionales ---
LOG_LEVEL=info
RATE_LIMIT_MAX=500
WORKDAY_TIMEZONE=America/Guatemala
NODE_DNS_SERVERS=

# --- URLs entre APIs (local / Compose). El contenedor Render las pisa a 127.0.0.1 ---
CORE_SERVICE_URL=http://localhost:3022
WORKDAY_SERVICE_URL=http://localhost:3021
AUTH_SERVICE_URL=http://localhost:3020
CORE_SERVICE_HOSTPORT=
WORKDAY_SERVICE_HOSTPORT=
AUTH_SERVICE_HOSTPORT=

# --- Vite (scoph-frontend lee este archivo; envDir = raíz del repo) ---
VITE_AUTH_SERVICE_URL=http://localhost:3020
VITE_WORKDAY_SERVICE_URL=http://localhost:3021
VITE_CORE_SERVICE_URL=http://localhost:3022
VITE_REPORTS_SERVICE_URL=http://localhost:3023
